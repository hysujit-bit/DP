# ─── DP Work App — Environment Variables ────────────────────────────────────────
# This file is safe to commit — it contains no real secrets.
# Copy to .env.local for local development, then fill in the values.
# In Netlify: add these under Site Settings → Environment Variables.

# Neon PostgreSQL — use the POOLED connection string from your Neon dashboard
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# Secret for signing JWT auth tokens (generate with the command below)
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-long-random-string

# Protects the one-time migration endpoint /api/migrate?secret=...
MIGRATE_SECRET=choose-a-password

NODE_ENV=development
